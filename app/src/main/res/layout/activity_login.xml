<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.activity.LoginActivity"
    android:background="@color/white">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/lltrasparentdesign"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"></LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvWelcome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:text="Welcome!"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_gravity="center"
                            android:layout_width="100dp"
                            android:layout_height="2dp"
                            android:background="@android:color/white"></LinearLayout>
                        <TextView

                            android:layout_marginTop="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="20sp"
                            android:text="Log In "
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp">
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        android:src="@drawable/useridicon"/>
                                    <EditText
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:layout_marginLeft="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:imeOptions="actionNext"
                                        android:singleLine="true"
                                        android:textColor="@android:color/white"
                                        android:textColorHint="@android:color/white"
                                        android:hint="Enter your user id"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@android:color/white"></LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="15dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        android:src="@drawable/keyicon"/>
                                    <EditText
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:inputType="textPassword"
                                        android:layout_weight="1"
                                        android:layout_marginLeft="5dp"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:imeOptions="actionNext"
                                        android:singleLine="true"
                                        android:textColor="@android:color/white"
                                        android:textColorHint="@android:color/white"
                                        android:hint="Enter your password"/>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.3">
                                        <TextView
                                            android:visibility="visible"

                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:textColor="@android:color/white"
                                            android:textSize="15sp"
                                            android:text="SHOW"/>
                                        <TextView

                                            android:visibility="gone"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:textColor="@android:color/white"
                                            android:textSize="15sp"
                                            android:text="HIDE"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@android:color/white"></LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="15dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        android:src="@drawable/securityicon"/>
                                    <EditText
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:layout_marginLeft="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:imeOptions="actionNext"
                                        android:singleLine="true"
                                        android:textColor="@android:color/white"
                                        android:textColorHint="#E5E5FD"
                                        android:hint="Enter your security code"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@android:color/white"></LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp">
                                    <CheckBox
                                        android:layout_weight="1"
                                        android:layout_width="0dp"
                                        android:layout_height="50dp"
                                        android:backgroundTint="@android:color/white"
                                        android:textColor="@android:color/white"
                                        android:textSize="12sp"
                                        android:text="REMEMBER ME"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="12sp"
                                        android:textColor="@android:color/white"
                                        android:text="Forgot Password"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="40dp"
                                    android:gravity="center">
                                    <LinearLayout
                                        android:gravity="center"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:background="@drawable/llovaldesign">
                                        <FrameLayout
                                            android:layout_gravity="center"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            >
                                            <ImageView
                                                android:visibility="visible"
                                                android:src="@drawable/logforwardicon"
                                                android:layout_width="30dp"
                                                android:layout_height="30dp"
                                                android:layout_gravity="center"/>
                                            <ProgressBar
                                                android:visibility="gone"
                                                android:layout_width="30dp"
                                                android:layout_height="30dp"
                                                android:layout_gravity="center"/>
                                        </FrameLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </ScrollView>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom|center"
            android:paddingRight="10dp"
            android:paddingBottom="10dp">
            <TextView
                android:visibility="gone"
                android:id="@+id/tvQuery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:text="Have a Query?Click here"></TextView>

        </LinearLayout>
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:text="Welcome Back"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"></TextView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_marginTop="10dp"
                    android:layout_gravity="center"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:background="@mipmap/mobile_login"
                    ></ImageView>
                <TextView
                    android:textStyle="bold|italic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:padding="20dp"
                    android:text="Welcome To\nGenius PayHR "></TextView>
            </FrameLayout>

        </LinearLayout>
        <TextView
            android:visibility="visible"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/android_text_color"
            android:text="Login to continue"
            ></TextView>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="26dp"
                    android:orientation="vertical"
                    >
                    <LinearLayout

                        android:background="@drawable/lldesign9"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/lldesign20"
                            android:backgroundTint="@color/colorAccent"
                            android:gravity="center">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/useridpayhr"
                                app:tint="@color/white" />
                        </LinearLayout>

                        <EditText
                            android:padding="10dp"
                            android:textSize="14sp"
                            android:id="@+id/etUserId"
                            android:layout_marginLeft="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:imeOptions="actionNext"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:hint="Enter user id"/>
                    </LinearLayout>

                    <LinearLayout

                        android:background="@drawable/lldesign9"
                        android:layout_marginTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/lldesign20"
                            android:backgroundTint="@color/contactcolor"
                            android:gravity="center">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/passwordpayhr"
                                app:tint="@color/white" />
                        </LinearLayout>
                        <EditText
                            android:padding="10dp"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:layout_weight="1"
                            android:id="@+id/etPassword"
                            android:layout_marginLeft="5dp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:imeOptions="actionNext"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:hint="Enter Password"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.3">
                            <TextView
                                android:textStyle="bold"
                                android:visibility="visible"
                                android:id="@+id/tvShow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/black"
                                android:textSize="15sp"
                                android:text="SHOW"/>
                            <TextView
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:id="@+id/tvHide"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/black"
                                android:textSize="15sp"
                                android:text="HIDE"/>
<!--                            <ImageView-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:visibility="visible"-->
<!--                                android:id="@+id/imgShow"-->
<!--                                android:src="@drawable/showiconpayhr"></ImageView>-->
<!--                            <ImageView-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:visibility="gone"-->
<!--                                android:id="@+id/imghide"-->
<!--                                android:src="@drawable/showiconpayhr"></ImageView>-->
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout

                        android:background="@drawable/lldesign9"
                        android:layout_marginTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/lldesign20"
                            android:backgroundTint="@color/yellow"
                            android:gravity="center">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/scodepayhr"
                                app:tint="@color/white" />
                        </LinearLayout>
                        <EditText
                            android:padding="10dp"
                            android:textSize="14sp"
                            android:id="@+id/etSecuritycode"
                            android:layout_marginLeft="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:imeOptions="actionNext"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:hint="Enter Security Code"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <CheckBox
                            android:id="@+id/ckRemember"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/colorAccent"
                            android:text="Remember Me"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:gravity="right"
                            android:textColor="@color/black"
                            android:id="@+id/tvForgot"
                            android:text="Forgot Password"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center">
                        <LinearLayout
                            android:gravity="center"
                            android:id="@+id/llSignIn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >
                            <FrameLayout
                                android:layout_gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                >
                                <TextView
                                    android:id="@+id/tvLogin"
                                    android:gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/lldesign9"
                                    android:paddingLeft="20dp"
                                    android:paddingRight="20dp"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp"
                                    android:backgroundTint="@color/colorAccent"
                                    android:text="Login"
                                    android:textColor="@color/white"></TextView>
                                <ProgressBar
                                    android:visibility="gone"
                                    android:id="@+id/pgBar"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom">
                        <TextView
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#9C27B0"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:layout_marginBottom="5dp"
                            android:text="2021 @ Genius HRTech Limited."
                            android:textSize="12sp"></TextView>
                    </LinearLayout>

                </LinearLayout>


        </ScrollView>

    </LinearLayout>
    </ScrollView>




</LinearLayout>

