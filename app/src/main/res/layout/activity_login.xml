<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/loginscreendesign"
    android:orientation="vertical"
    tools:context=".activity.activity.LoginActivity">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/lltrasparentdesign"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"></LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvWelcome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:text="Welcome!"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_gravity="center"
                            android:layout_width="100dp"
                            android:layout_height="2dp"
                            android:background="@android:color/white"></LinearLayout>
                        <TextView
                            android:id="@+id/tvLogin"
                            android:layout_marginTop="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="20sp"
                            android:text="Log In "
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp">
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        android:src="@drawable/useridicon"/>
                                    <EditText
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:id="@+id/etUserId"
                                        android:layout_marginLeft="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:imeOptions="actionNext"
                                        android:singleLine="true"
                                        android:textColor="@android:color/white"
                                        android:textColorHint="@android:color/white"
                                        android:hint="Enter your user id"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@android:color/white"></LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="15dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        android:src="@drawable/keyicon"/>
                                    <EditText
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:inputType="textPassword"
                                        android:layout_weight="1"
                                        android:id="@+id/etPassword"
                                        android:layout_marginLeft="5dp"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:imeOptions="actionNext"
                                        android:singleLine="true"
                                        android:textColor="@android:color/white"
                                        android:textColorHint="@android:color/white"
                                        android:hint="Enter your password"/>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.3">
                                        <TextView
                                            android:textStyle="bold"
                                            android:visibility="visible"
                                            android:id="@+id/tvShow"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:textColor="@android:color/white"
                                            android:textSize="15sp"
                                            android:text="SHOW"/>
                                        <TextView
                                            android:textStyle="bold"
                                            android:visibility="gone"
                                            android:id="@+id/tvHide"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:textColor="@android:color/white"
                                            android:textSize="15sp"
                                            android:text="HIDE"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@android:color/white"></LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="15dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        android:src="@drawable/securityicon"/>
                                    <EditText
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:id="@+id/etSecuritycode"
                                        android:layout_marginLeft="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:imeOptions="actionNext"
                                        android:singleLine="true"
                                        android:textColor="@android:color/white"
                                        android:textColorHint="#E5E5FD"
                                        android:hint="Enter your security code"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@android:color/white"></LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp">
                                    <CheckBox
                                        android:layout_weight="1"
                                        android:id="@+id/ckRemember"
                                        android:layout_width="0dp"
                                        android:layout_height="50dp"
                                        android:backgroundTint="@android:color/white"
                                        android:textColor="@android:color/white"
                                        android:textSize="12sp"
                                        android:text="REMEMBER ME"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="12sp"
                                        android:textColor="@android:color/white"
                                        android:id="@+id/tvForgot"
                                        android:text="Forgot Password"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="40dp"
                                    android:gravity="center">
                                    <LinearLayout
                                        android:gravity="center"
                                        android:id="@+id/llSignIn"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:background="@drawable/llovaldesign">
                                        <FrameLayout
                                            android:layout_gravity="center"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            >
                                            <ImageView
                                                android:id="@+id/imgForward"
                                                android:visibility="visible"
                                                android:src="@drawable/logforwardicon"
                                                android:layout_width="30dp"
                                                android:layout_height="30dp"
                                                android:layout_gravity="center"/>
                                            <ProgressBar
                                                android:visibility="gone"
                                                android:id="@+id/pgBar"
                                                android:layout_width="30dp"
                                                android:layout_height="30dp"
                                                android:layout_gravity="center"/>
                                        </FrameLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </ScrollView>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom|center"
            android:paddingRight="10dp"
            android:paddingBottom="10dp">
            <TextView
                android:visibility="gone"
                android:id="@+id/tvQuery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:text="Have a Query?Click here"></TextView>

        </LinearLayout>
    </FrameLayout>





</LinearLayout>

