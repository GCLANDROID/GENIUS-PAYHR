<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/lnDaycoMin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@mipmap/boxbg"
                    android:orientation="vertical"
                    android:layout_marginLeft="50dp"
                    android:paddingLeft="60dp">
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/tvInTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/text_color"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        android:text="Saraswati Puja"></TextView>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/tvOutTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/text_color"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        ></TextView>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="80dp"
                    android:orientation="vertical"
                    >
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:visibility="gone"
                            android:orientation="vertical"
                            android:id="@+id/llRestricted"
                            android:background="@drawable/lldesign"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:backgroundTint="@color/orange"></LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/llFixed"
                            android:background="@drawable/lldesign"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:backgroundTint="@color/textcolor1"></LinearLayout>

                        <LinearLayout
                            android:gravity="center"
                            android:paddingRight="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:id="@+id/tvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@android:color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:text="12 feb 2021"></TextView>
                        </LinearLayout>
                    </FrameLayout>

                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="2dp"
            android:layout_height="50dp"
            android:background="@color/black"
            android:layout_marginLeft="50dp"></LinearLayout>




    </LinearLayout>


</layout>
