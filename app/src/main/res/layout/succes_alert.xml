<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/alert_width"
    android:layout_height="@dimen/alert_height"
    android:layout_gravity="center"
    android:fitsSystemWindows="true">
    <FrameLayout
        android:layout_width="@dimen/alert_width"
        android:layout_height="@dimen/alert_height"
        >
        <LinearLayout
            android:layout_width="@dimen/alert_width"
            android:layout_height="@dimen/alert_width"
            android:orientation="vertical"
            android:background="@drawable/lldesign"
            android:layout_marginTop="35dp">
            <TextView
                android:textAlignment="center"
                android:id="@+id/tvSuccess"
                android:layout_marginTop="100dp"
                android:layout_gravity="center"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your registration has been done successfully"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_view"
                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                card_view:cardElevation="0dp"
                android:layout_gravity="center"
                card_view:cardUseCompatPadding="true"
                android:layout_marginTop="30dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@color/textcolor1"
                    android:gravity="center"
                    android:id="@+id/llOk">
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/tvOk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:text="OK"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
        <LinearLayout
            android:layout_width="@dimen/alert_width"
            android:layout_height="70dp"
            android:gravity="center"
            android:background="#03060606">
            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/successicon"
                app:tint="@color/textcolor1" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
