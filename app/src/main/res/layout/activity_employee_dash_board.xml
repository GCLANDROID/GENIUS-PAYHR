<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:id="@+id/dlMain"
    tools:context=".activity.activity.EmployeeDashBoardActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_deafult" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good Morning"
                    android:textColor="@android:color/black"
                    android:textSize="12sp"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEmployeeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Demo"
                        android:textColor="@android:color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_marginBottom="5dp"
                        android:id="@+id/tvLoginDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:text="9 august 2018"
                        android:textColor="@android:color/black"
                        android:textSize="12sp" />


                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="10dp"

                android:orientation="vertical"
                android:padding="10dp"
                android:weightSum="6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:weightSum="3">
                        //profile

                        <LinearLayout
                            android:id="@+id/llProfile"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/layout_margin_left_right"
                            android:layout_marginRight="@dimen/layout_margin_left_right"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView

                                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                card_view:cardElevation="3dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/man" />


                                    <TextView
                                        android:id="@+id/tvProfile"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="PROFILE"
                                        android:textAppearance="?android:textAppearanceMedium"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="11sp" />


                                </LinearLayout>
                            </androidx.cardview.widget.CardView>


                        </LinearLayout>
                        //payroll

                        <LinearLayout
                            android:id="@+id/llPayroll"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/layout_margin_left_right"
                            android:layout_marginTop="@dimen/layout_margin_left_right"
                            android:layout_marginRight="@dimen/layout_margin_left_right"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <androidx.cardview.widget.CardView

                                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                card_view:cardElevation="3dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/ic_piggy_bank" />

                                    <TextView
                                        android:id="@+id/tvPayroll"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="PAYROLL"
                                        android:textAppearance="?android:textAppearanceMedium"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="11sp" />


                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>
                        //leave


                        <LinearLayout
                            android:id="@+id/llLeave"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/layout_margin_left_right"
                            android:layout_marginTop="@dimen/layout_margin_left_right"
                            android:layout_marginRight="@dimen/layout_margin_left_right"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView

                                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                card_view:cardElevation="3dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/ic_exit" />

                                    <TextView
                                        android:id="@+id/tvLeave"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="LEAVE APPLICATION"
                                        android:textAppearance="?android:textAppearanceMedium"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="11sp" />


                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>





                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:weightSum="3">
                        //daily log

                        <LinearLayout
                            android:id="@+id/llDailyLog"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/layout_margin_left_right"
                            android:layout_marginRight="@dimen/layout_margin_left_right"
                            android:layout_weight="1"
                            android:orientation="vertical"

                            android:visibility="visible">

                            <androidx.cardview.widget.CardView

                                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                card_view:cardElevation="3dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/notebook" />

                                    <TextView
                                        android:id="@+id/tvDailyLog"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="DAILY LOG "
                                        android:textAppearance="?android:textAppearanceMedium"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="11sp" />


                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        //attendance


                        <LinearLayout
                            android:id="@+id/llAttenDance"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/layout_margin_left_right"
                            android:layout_marginTop="@dimen/layout_margin_left_right"
                            android:layout_marginRight="@dimen/layout_margin_left_right"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView

                                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                card_view:cardElevation="1dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/ic_select" />

                                    <TextView
                                        android:id="@+id/tvAttendance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="ATTENDANCE"
                                        android:textAppearance="?android:textAppearanceMedium"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="11sp" />


                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        //geofence

                        <LinearLayout
                            android:id="@+id/llGeoFence"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/layout_margin_left_right"
                            android:layout_marginTop="@dimen/layout_margin_left_right"
                            android:layout_marginRight="@dimen/layout_margin_left_right"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <androidx.cardview.widget.CardView

                                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                card_view:cardElevation="3dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/ic_fence" />

                                    <TextView
                                        android:id="@+id/tvGeoFence"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="GEO FENCE"
                                        android:textAppearance="?android:textAppearanceMedium"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="11sp" />


                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        //daily activity

                        <LinearLayout
                            android:id="@+id/llDailyActivity"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/layout_margin_left_right"
                            android:layout_marginRight="@dimen/layout_margin_left_right"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <androidx.cardview.widget.CardView

                                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                card_view:cardElevation="3dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/ic_union" />

                                    <TextView
                                        android:id="@+id/tvDailyActivity"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="DAILY ACTIVITY"
                                        android:textAppearance="?android:textAppearanceMedium"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="11sp" />


                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>


                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        android:id="@+id/llDrawerPane"
        layout="@layout/drawer_layout"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:fitsSystemWindows="false"
        android:focusableInTouchMode="false" />





</androidx.drawerlayout.widget.DrawerLayout>