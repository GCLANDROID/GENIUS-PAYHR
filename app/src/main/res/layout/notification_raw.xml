<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="#F1EEEE"
                android:weightSum="3">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.5"
                    android:layout_gravity="center"
                    android:src="@drawable/date_img_payhr"
                    ></ImageView>
                <TextView
                    android:textColor="@color/color1"
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:id="@+id/tvDateTitle"
                    android:text="Date"/>
                <TextView
                    android:id="@+id/tvDate"
                    android:textColor="@color/color1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textSize="12sp"
                    android:layout_weight="1.5"
                    android:text="Date "/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="10dp">
        <LinearLayout
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1EEEE"
            android:weightSum="3">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center"
                android:src="@drawable/location_img_payhr"
                ></ImageView>
            <TextView
                android:textColor="@color/color1"
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_weight="1"
                android:id="@+id/tvLocationTitle"
                android:text="Location/Branches"/>
            <TextView
                android:id="@+id/tvLocation"
                android:textColor="@color/color1"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textSize="12sp"
                android:layout_weight="1.5"
                android:text="Location/Branches"/>

        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="#F1EEEE"
            android:weightSum="3">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center"
                android:src="@drawable/total_employee_img_payhr"
                ></ImageView>
            <TextView
                android:textColor="@color/color1"
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/tvTotalTitle"
                android:layout_weight="1"
                android:text="Total Employee"/>
            <TextView
                android:id="@+id/tvTotal"
                android:textColor="@color/color1"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textSize="12sp"
                android:layout_weight="1.5"
                android:text="Total Employee"/>

        </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/llIn"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="#F1EEEE"
                android:weightSum="3">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.5"
                    android:layout_gravity="center"
                    android:src="@drawable/in_img_payhr"
                    ></ImageView>
                <TextView
                    android:textColor="@color/color1"
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textSize="12sp"
                    android:id="@+id/tvPresentTitle"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:text="IN"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_weight="1.5">
                <TextView
                    android:id="@+id/tvPresent"
                    android:textColor="@color/color1"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="10"/>
                <TextView
                    android:id="@+id/tvPresentPer"
                    android:textColor="@color/color1"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="(10%)"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="#F1EEEE"
                android:id="@+id/llOut"
                android:weightSum="3"
                >
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.5"
                    android:layout_gravity="center"
                    android:src="@drawable/out_img_payhr"
                    ></ImageView>
                <TextView
                    android:textColor="@color/color1"
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textSize="12sp"
                    android:id="@+id/tvAbsentTitle"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:text="OUT"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:paddingLeft="5dp">
                    <TextView
                        android:id="@+id/tvAbsent"
                        android:textColor="@color/color1"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:text="8"/>
                    <TextView
                        android:id="@+id/tvAbsentPer"
                        android:textColor="@color/color1"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:text="(8%)"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:id="@+id/llNot"
                android:background="#F1EEEE"
                android:weightSum="3">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.5"
                    android:layout_gravity="center"
                    android:src="@drawable/notmarked_img_payhr"
                    ></ImageView>
                <TextView
                    android:textColor="@color/color1"
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textSize="12sp"
                    android:id="@+id/tvNotMarkTitle"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:text="NOT MARK"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:paddingLeft="5dp">
                    <TextView
                        android:id="@+id/tvNotMark"
                        android:textColor="@color/color1"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:text="8"/>
                    <TextView
                        android:id="@+id/tvNotMarkPer"
                        android:textColor="@color/color1"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:text="(8%)"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
