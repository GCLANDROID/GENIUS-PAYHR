<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="300dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="40dp"
        android:background="@mipmap/headerribbon"
        android:gravity="center">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_weight="0.7"
            android:gravity="right"
            android:textColor="@android:color/white"
            android:text="Choose your language"></TextView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="0.3"
            android:gravity="end">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/imgCancelDialog"
                app:tint="@color/white"
                android:layout_marginRight="2dp"
                android:layout_gravity="end"
                android:src="@drawable/cancelicon"></ImageView>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="260dp"
        android:gravity="center"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="100dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/llEnglish">

                    <LinearLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        >
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center">
                            <ImageView
                                android:visibility="gone"
                                android:id="@+id/imgGreyBridge"
                                android:layout_gravity="center"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/greybridge"></ImageView>
                            <ImageView
                                android:id="@+id/imgBlueBridge"
                                android:layout_gravity="center"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/bluebridge"></ImageView>
                        </FrameLayout>
                        <TextView
                            android:textColor="#72128E"
                            android:id="@+id/tvEnglish"
                            android:layout_marginTop="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:text="English"></TextView>


                    </LinearLayout>




            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/llHindi">

                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    >
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">
                        <ImageView
                            android:visibility="visible"
                            android:id="@+id/imgGreyTajMahal"
                            android:layout_gravity="center"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/greytajmahal"></ImageView>
                        <ImageView
                            android:visibility="gone"
                            android:id="@+id/imgBlueTajMahal"
                            android:layout_gravity="center"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/bluetajmahal"></ImageView>
                    </FrameLayout>
                    <TextView
                        android:textColor="#B1ACAC"
                        android:id="@+id/tvHindi"
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:text="Hindi"></TextView>


                </LinearLayout>




            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:visibility="gone"
            android:weightSum="2"
            android:layout_width="320dp"
            android:layout_height="100dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/llTamil">

                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    >
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">
                        <ImageView
                            android:visibility="visible"
                            android:id="@+id/imgGreyTamil"
                            android:layout_gravity="center"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/grey_tamil"></ImageView>
                        <ImageView
                            android:visibility="gone"
                            android:id="@+id/imgBlueTamil"
                            android:layout_gravity="center"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/bluetamil"></ImageView>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tvTamil"
                        android:textColor="#B1ACAC"
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:text="Tamil"></TextView>


                </LinearLayout>




            </LinearLayout>


        </LinearLayout>
    </LinearLayout>

</LinearLayout>
