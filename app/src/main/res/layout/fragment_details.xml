<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.leaveapplication.DetailsFragment"
    android:orientation="vertical"
    android:fitsSystemWindows="true">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:orientation="horizontal">
    <LinearLayout
        android:id="@+id/llStrtDate"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">
      <ImageView
          android:id="@+id/imgStrtDate"
          android:layout_width="25dp"
          android:layout_height="25dp"
          android:src="@drawable/calendaricon"></ImageView>
      <TextView
          android:text="Select your leave start date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="12sp"
          android:textColor="@color/color8"
          android:layout_marginLeft="5dp"
          android:id="@+id/tvStrtDate"></TextView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llEndDate"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">
      <ImageView
          android:id="@+id/imgEndDate"
          android:layout_width="25dp"
          android:layout_height="25dp"
          android:src="@drawable/calendaricon"></ImageView>
      <TextView
          android:text="Select your leave end date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="12sp"
          android:textColor="@color/color8"
          android:layout_marginLeft="5dp"
          android:id="@+id/tvEndDate"></TextView>
    </LinearLayout>
  </LinearLayout>

  <Button
      android:layout_width="100dp"
      android:layout_height="40dp"
      android:layout_gravity="center"
      android:layout_marginTop="10dp"
      android:background="@mipmap/headerribbon"
      android:textColor="@android:color/white"
      android:textSize="13sp"
      android:text="Show"
      android:id="@+id/btnShow"/>

  <LinearLayout
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:id="@+id/llLoader"
      android:gravity="center">
    <ProgressBar
        android:layout_width="50dp"
        android:layout_height="50dp"></ProgressBar>
  </LinearLayout>
  <LinearLayout
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:id="@+id/llMain"
      android:orientation="vertical">
    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/rvItem"></androidx.recyclerview.widget.RecyclerView>
  </LinearLayout>
  <LinearLayout
      android:id="@+id/llNoData"
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:gravity="center">
    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/search"></ImageView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:text="No data(s) found!"
        android:textColor="@android:color/black"></TextView>
  </LinearLayout>




</LinearLayout>